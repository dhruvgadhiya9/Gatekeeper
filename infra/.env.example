# Copy to infra/.env and replace every value. Never commit infra/.env.

# Host ports. These avoid clashing with a Postgres or web server already on the machine.
# The Vite dev server proxies to port 8081, so update frontend/vite.config.ts if you change it.
BACKEND_PORT=8081
POSTGRES_PORT=5433

POSTGRES_DB=gatekeeper
POSTGRES_USER=gatekeeper
POSTGRES_PASSWORD=change-me

RABBITMQ_USER=gatekeeper
RABBITMQ_PASSWORD=change-me

MINIO_ROOT_USER=gatekeeper
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars

# Base64-encoded 32 random bytes. Generate one with:
#   PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#   Linux/macOS: openssl rand -base64 32
# Changing it later makes stored credentials unreadable.
APP_ENCRYPTION_KEY=
