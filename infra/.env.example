# Copy to infra/.env and replace every value. Never commit infra/.env.

# Host ports. These avoid clashing with a Postgres or web server already on the machine.
# The Vite dev server proxies to port 8081, so update frontend/vite.config.ts if you change it.
BACKEND_PORT=8081
POSTGRES_PORT=5433

POSTGRES_DB=gatekeeper
POSTGRES_USER=gatekeeper
POSTGRES_PASSWORD=change-me

RABBITMQ_USER=gatekeeper
RABBITMQ_PASSWORD=change-me

MINIO_ROOT_USER=gatekeeper
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars

# Base64-encoded 32 random bytes. Generate one with:
#   PowerShell: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
#   Linux/macOS: openssl rand -base64 32
# Changing it later makes stored credentials unreadable.
APP_ENCRYPTION_KEY=

# Base64-encoded 32 random bytes, generated the same way. Signs login tokens.
# Changing it signs everyone out.
APP_JWT_SECRET=

# Comma-separated. These domains and their subdomains can never be used as a staging URL.
APP_PRODUCTION_DOMAINS=

# GitHub App. Leave empty until it exists; the wizard then takes typed repositories.
# Permissions: Contents read, Metadata read, Pull requests write.
GITHUB_APP_ID=
# The App's private key file, Base64-encoded on one line:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.pem"))
#   Linux/macOS: base64 -w0 key.pem
GITHUB_APP_PRIVATE_KEY=

# Zoho OAuth client (server-based application). Leave empty until it exists; the wizard then
# takes typed Zoho IDs. Its redirect URI is <PUBLIC_URL>/api/integrations/zoho/callback.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# us, eu, in, au, jp, ca, cn, sa, uk, ae or sg
ZOHO_DATA_CENTER=in
# Attaching files needs broad WorkDrive scopes. Set to false to leave them out.
ZOHO_ATTACHMENTS_ENABLED=true

# Base64-encoded 32 random bytes, different from the keys above. Signs sandbox job tokens.
APP_JOB_TOKEN_SECRET=

# Anthropic API key. Only the backend holds it; sandboxes reach the API through its proxy.
ANTHROPIC_API_KEY=
# The model agents run on, and a small one for background tasks. Each run is paid per token.
LLM_MODEL=claude-opus-5-5
LLM_SMALL_MODEL=claude-haiku-5-5
# The most one run may use: input + output + cache writes + a tenth of cache reads. It stops there.
SANDBOX_TOKEN_BUDGET=5000000
SANDBOX_TIME_LIMIT=60m

# Browser-facing address of the app. The OIDC redirect URI is built from it.
PUBLIC_URL=http://localhost:5173
# Must be true anywhere other than plain-HTTP localhost.
COOKIE_SECURE=false

# Comma-separated. Verified emails here become ADMIN when they sign in.
APP_ADMIN_EMAILS=admin@gatekeeper.test
# Comma-separated. Empty allows any account the identity provider accepts. Set this for Google.
APP_ALLOWED_EMAIL_DOMAINS=

# OIDC provider. These values use the local Keycloak; any OIDC issuer works
# (Google: https://accounts.google.com, Azure AD: https://login.microsoftonline.com/<tenant>/v2.0).
OIDC_ISSUER_URI=http://keycloak.localhost:8180/realms/gatekeeper
OIDC_CLIENT_ID=gatekeeper-backend
OIDC_CLIENT_SECRET=change-me

# Local Keycloak only.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
# Password for the seeded users: admin, qalead and viewer.
KEYCLOAK_TEST_USER_PASSWORD=change-me
